{
  "name": "ez-php/swagger-ui",
  "version": "2.3.2",
  "description": "Serves Swagger UI / ReDoc documentation for the OpenAPI spec produced by ez-php/openapi",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["swagger-ui", "redoc", "openapi", "documentation", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/swagger-ui",
  "support": {
    "issues": "https://github.com/ez-php/swagger-ui/issues",
    "source": "https://github.com/ez-php/swagger-ui"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.0",
    "ez-php/http": "^2.0",
    "ez-php/framework": "^2.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\SwaggerUI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
